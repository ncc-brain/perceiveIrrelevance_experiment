}

@article{fleming_how_2014,
	title = {How to measure metacognition},
	volume = {8},
	issn = {1662-5161},
	url = {https://www.frontiersin.org/journals/human-neuroscience/articles/10.3389/fnhum.2014.00443/full},
	doi = {10.3389/fnhum.2014.00443},
	abstract = {{\textless}p{\textgreater}The ability to recognize one's own successful cognitive processing, in e.g., perceptual or memory tasks, is often referred to as metacognition. How should we quantitatively measure such ability? Here we focus on a class of measures that assess the correspondence between trial-by-trial accuracy and one's own confidence. In general, for healthy subjects endowed with metacognitive sensitivity, when one is confident, one is more likely to be correct. Thus, the degree of association between accuracy and confidence can be taken as a quantitative measure of metacognition. However, many studies use a statistical correlation coefficient (e.g., Pearson's {\textless}italic{\textgreater}r{\textless}/italic{\textgreater}) or its variant to assess this degree of association, and such measures are susceptible to undesirable influences from factors such as response biases. Here we review other measures based on signal detection theory and receiver operating characteristics (ROC) analysis that are “bias free,” and relate these quantities to the calibration and discrimination measures developed in the probability estimation literature. We go on to distinguish between the related concepts of metacognitive {\textless}italic{\textgreater}bias{\textless}/italic{\textgreater} (a difference in subjective confidence despite basic task performance remaining constant), metacognitive {\textless}italic{\textgreater}sensitivity{\textless}/italic{\textgreater} (how good one is at distinguishing between one's own correct and incorrect judgments) and metacognitive {\textless}italic{\textgreater}efficiency{\textless}/italic{\textgreater} (a subject's level of metacognitive sensitivity given a certain level of task performance). Finally, we discuss how these three concepts pose interesting questions for the study of metacognition and conscious awareness.{\textless}/p{\textgreater}},
	language = {English},
	urldate = {2024-07-19},
	journal = {Frontiers in Human Neuroscience},
	author = {Fleming, Stephen M. and Lau, Hakwan C.},
	month = jul,
	year = {2014},
	note = {Publisher: Frontiers},
	keywords = {Consciousness, metacognition, confidence, Probability judgment, Signal detection theory},
}

@article{shea_global_2019,
	title = {The {Global} {Workspace} {Needs} {Metacognition}},
